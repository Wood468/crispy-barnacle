    "zorua": {
      "source": {
        "label": "pokemongo.com news post",
        "trust": "official",
        "url": "https://pokemongo.com/news/communityday-october-2026-zorua",
        "observed": "2026-10-09"
      },
      "info": [
        {
          "k": "Spawns",
          "status": "published",
          "text": "Zorua appears more often in the wild. With a regular Lure, Zorua is very likely at PokéStops from 2 to 9 pm."
        },
        {
          "k": "Raids",
          "status": "not-published",
          "text": "No raids are listed for this event.",
          "note": "Not the same as none. Shown until a source says."
        },
        {
          "k": "Eggs",
          "status": "not-published",
          "text": "No egg changes are listed."
        },
        {
          "k": "Research",
          "status": "published",
          "text": "Zorua Field Research gives Stardust, Ultra Balls and extra Zorua encounters. Special Research is a paid ticket, below.",
          "note": "The specific Field Research tasks are not published yet."
        },
        {
          "k": "Shiny",
          "status": "published",
          "text": "Shiny Zorua is possible. Lured Zorua have a higher Shiny chance.",
          "note": "Odds are not published yet."
        },
        {
          "k": "Exclusive move",
          "status": "published",
          "text": "Evolve Zorua during the event, or within 4 hours after, for a Zoroark with Sucker Punch.",
          "moves": [
            {
              "name": "Sucker Punch",
              "type": "Dark"
            }
          ]
        },
        {
          "k": "New forms",
          "status": "published",
          "text": "Special Background Zorua are possible but rare.",
          "note": "Chances are not published yet."
        },
        {
          "k": "Other",
          "status": "partial",
          "text": "Community Ambassador check-in unlocks Timed Research with more Special Background Zorua.",
          "note": "Dates and places of those events are not published yet."
        }
      ],
      "tickets": [
        "zorua-cd-research",
        "zorua-cd-ultrabox"
      ],
      "alsoRunning": [
        "go-pass-oct-free",
        "go-pass-oct-deluxe"
      ],
      "names": [
        "Zorua Community Day"
      ],
      "scheduleNotes": [
        "Community Day runs from 2:00–5:00 p.m. local time. Regular Lure Modules can continue attracting Zorua until 9:00 p.m. local time; that extended window is separate from the main event hours.",
        "The three-hour Incense bonus excludes Daily Adventure Incense, and the one-hour Lure bonus excludes Golden Lure Modules."
      ]
    },
